# Python
__pycache__/
*.pyc

# Node
node_modules/

# Virtual environments
.venv/
venv/

# PyInstaller build output (regenerate with the commands in docs/SETUP.md)
build/
dist/
*.spec

# TypeScript / Vite build output
functions/lib/
web/dist/

# Built installer (large binary -- distribute via GitHub Releases instead)
release/*.exe

# Per-machine agent state -- generated on first run, contains secrets
client_agent/config.json
client_agent/credentials.json
client_agent/data/
client_agent/logs/

# Web app's Firebase project config (not secret, but env-specific)
web/.env.local

# Firebase CLI / emulator local state
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# Logs
*.log

# Claude Code local session settings (personal, not shared)
.claude/settings.local.json

# TypeScript incremental build cache
*.tsbuildinfo

# Claude Code local task state
.claude/
